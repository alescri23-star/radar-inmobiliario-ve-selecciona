RESEND_API_KEY=
RADAR_MAIL_FROM=
RADAR_PUBLIC_URL=http://127.0.0.1:3000
# Alternativa a Resend: webhook privado de Make que envía el correo.
RADAR_RESET_WEBHOOK_URL=
# Opcional si el escenario valida una cabecera Bearer.
RADAR_RESET_WEBHOOK_SECRET=
RADAR_FORM_ORIGIN=https://orangered-cod-348216.hostingersite.com

# Producción en Hostinger Business (MySQL incluido). No guardar valores reales aquí.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# HTTPS obligatorio con NODE_ENV=production. Para desarrollo: http://127.0.0.1:3000
# No activar consultas externas sin autorización de las fuentes.
RADAR_GALLERY_REMOTE=false
# Las credenciales RADAR_ADMIN_* son temporales: inyectarlas de forma segura para node admin.mjs.
# No guardar contraseñas de administración aquí.
RADAR_ADMIN_NAME=
RADAR_ADMIN_EMAIL=
RADAR_ADMIN_PASSWORD=
